diff --git a/qml/components/PageHost.qml b/qml/components/PageHost.qml
index 8f157a6..3741716 100644
--- a/qml/components/PageHost.qml
+++ b/qml/components/PageHost.qml
@@ -1,68 +1,89 @@
 // SPDX-License-Identifier: AGPL-3.0-or-later
-// Hosts settings/catalog pages with shared loading/lifecycle behavior for Settings surfaces.
-// REL: qml/settings/SettingsView.qml, qml/services/FeatureCatalog.qml – page IDs/entries/navigation.
+// Hosts settings/control pages and the overlay panels with one retained Loader per key.
+// REL: qml/settings/SettingsView.qml, qml/panels/ControlCenter.qml, shell.qml – keys/resolve.
 pragma ComponentBehavior: Bound
 import QtQuick
-import "../components"
 import "../theme"
 
-// Hosts one settings page at a time. The next page incubates asynchronously
-// in a second loader while the current one stays mounted, so page switches
-// never block the UI thread and never blank the content area.
+// Every page that was built stays built (hidden pages are visible: false, which stops their
+// visible-bound timers), so a revisit is the next frame. A page the user asks for builds
+// synchronously: Quickshell incubates asynchronous work for ~1/3 frame per frame while
+// anything animates, several times slower than the raw build. warmKeys build in the
+// background, asynchronously and one at a time, once the first page is on screen.
 Item {
     id: root
-    property Component content: null
-    readonly property var item: current.item
-    property Loader current: loaderA
-    property Loader incoming: loaderB
+    property string key: ""
+    // key => Component; a null result leaves the shown page in place.
+    property var resolve: null
+    property var warmKeys: []
+    property int warmInterval: 150
+    property bool animate: true
+    // false hides the shown page as well (a closed window keeps no page timers alive).
+    property bool active: true
+    readonly property var item: shown ? shown.item : null
+    property Loader shown: null
+    property var entries: ({})
+    property int warmIndex: 0
     property real enter: 1
+    signal pageLoaded(var item)
 
-    function activate(loader) {
-        if (current === loader) return;
-        const previous = current;
-        current = loader;
-        incoming = loader === loaderA ? loaderB : loaderA;
-        // Deletion of the retired page is queued; hide it now so the two pages
-        // can never render on top of each other.
-        previous.visible = false;
-        previous.active = false;
-        previous.sourceComponent = null;
-        loader.visible = true;
-        if (Theme.animations) { enter = 0; enterMotion.restart(); }
+    function entry(pageKey, sync) {
+        let page = entries[pageKey];
+        if (page) {
+            // Finish an in-flight background build now instead of in frame-sized slices.
+            if (sync && page.asynchronous && page.status === Loader.Loading) page.asynchronous = false;
+            return page;
+        }
+        const content = pageKey && resolve ? resolve(pageKey) : null;
+        if (!content) return null;
+        page = pageLoader.createObject(root, {pageKey: pageKey, asynchronous: !sync});
+        entries[pageKey] = page;
+        page.sourceComponent = content;
+        return page;
+    }
+    function present(page) {
+        if (shown === page) return;
+        const hadFocus = !!shown && shown.activeFocus;
+        shown = page;
+        page.focus = true;
+        if (hadFocus) page.forceActiveFocus();
+        if (animate && Theme.animations) { enter = 0; enterMotion.restart(); }
         else enter = 1;
+        if (warmIndex < warmKeys.length) warmDelay.restart();
     }
-
-    function dispatch() {
-        if (!content) return;
-        if (current.sourceComponent === content && current.status === Loader.Ready) {
-            // The visible page already matches; cancel any incubation still in
-            // flight so a late onLoaded cannot swap the wrong page in.
-            if (incoming.active) { incoming.active = false; incoming.sourceComponent = null; }
-            return;
+    function show() {
+        const page = entry(key, true);
+        if (page && page.status === Loader.Ready) present(page);
+    }
+    function warmNext() {
+        while (warmIndex < warmKeys.length) {
+            const page = entries[warmKeys[warmIndex]] ? null : entry(warmKeys[warmIndex], false);
+            warmIndex++;
+            if (page && page.status === Loader.Loading) return; // its onLoaded schedules the next
         }
-        if (incoming.sourceComponent === content && incoming.status === Loader.Ready) { activate(incoming); return; }
-        if (incoming.sourceComponent !== content) incoming.sourceComponent = content;
-        incoming.active = true;
     }
+    onKeyChanged: show()
+    onResolveChanged: show()
+    onWarmKeysChanged: { warmIndex = 0; if (shown) warmDelay.restart(); }
+    onActiveFocusChanged: if (activeFocus && shown) shown.forceActiveFocus()
+    Component.onCompleted: show()
+    Component.onDestruction: warmDelay.stop()
 
-    onContentChanged: dispatch()
-    Component.onCompleted: dispatch()
-
-    Loader {
-        id: loaderA
-        anchors.fill: parent
-        asynchronous: true
-        active: false
-        visible: false
-        onLoaded: if (root.incoming === loaderA && root.content === loaderA.sourceComponent) root.activate(loaderA)
-    }
-    Loader {
-        id: loaderB
-        anchors.fill: parent
-        asynchronous: true
-        active: false
-        visible: false
-        onLoaded: if (root.incoming === loaderB && root.content === loaderB.sourceComponent) root.activate(loaderB)
+    Timer { id: warmDelay; interval: root.warmInterval; onTriggered: root.warmNext() }
+    Component {
+        id: pageLoader
+        Loader {
+            id: page
+            required property string pageKey
+            anchors.fill: parent
+            visible: root.active && root.shown === page
+            onLoaded: {
+                root.pageLoaded(item);
+                if (pageKey === root.key) root.present(page);
+                else warmDelay.restart();
+            }
+            onStatusChanged: if (status === Loader.Error) warmDelay.restart()
+        }
     }
 
     transform: Translate { y: (1 - root.enter) * 28 }
